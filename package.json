{
  "name": "miss-supatool",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "description": "Miss Supatool — copie les données d'un projet Supabase vers un autre (tables via PostgREST, fichiers via l'API Storage). PWA locale : les clés ne quittent jamais le navigateur, aucun serveur intermédiaire.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pwa-bundle-budget",
    "build:analyze": "cross-env ANALYZE=1 npm run build",
    "preview": "vite preview --base /miss-supatool/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc -b",
    "icons": "pwa-icons --source public/favicon.svg --out public --sizes 180,192,512",
    "icons:maskable": "node scripts/generate-maskable.mjs",
    "prepare": "husky || true"
  },
  "bundleBudget": {
    "totalGzipKb": 200
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mister-guiiug/dev-pwa-config": "^4.11.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
